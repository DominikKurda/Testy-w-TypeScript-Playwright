import { test, expect } from '@playwright/test';

// =========================
// Stałe
// =========================
const HOME_URL = 'http://www.selenium-shop.pl/';
const PRODUCT_URL = 'http://www.selenium-shop.pl/produkt/koszulka-manchester-fc-city/';
const CART_URL = 'http://www.selenium-shop.pl/koszyk/';

const PRODUCT = {
  quantity: '2',
  expectedPrice: 360,
};

test('Cena za 2 koszulki wynosi 360 zł', async ({ page }) => {
  // =========================
  // Lokatory produktu
  // =========================
  const quantityInput = page.locator('input.qty');
  const addToCartButton = page.locator('button.single_add_to_cart_button');
  const successMessage = page.locator('.woocommerce-message');

  // =========================
  // Lokatory koszyka
  // =========================
  const cartPrice = page.locator(
    'td.product-subtotal .woocommerce-Price-amount, td.product-subtotal bdi',
  );

  // =========================
  // Funkcja pobierania ceny
  // =========================
  const getCartPrice = async (): Promise<number> => {
    const priceText = await cartPrice.textContent();

    expect(priceText).not.toBeNull();

    return parseFloat(
      priceText!.replace(/[^0-9.,]/g, '').replace(',', '.'),
    );
  };

  // =========================
  // 1. Otwórz stronę główną
  // =========================
  await page.goto(HOME_URL, {
    waitUntil: 'domcontentloaded',
  });

  await expect(page).toHaveURL(HOME_URL);

  await page.waitForTimeout(2000);

  // =========================
  // 2. Otwórz stronę produktu
  // =========================
  await page.goto(PRODUCT_URL);

  // =========================
  // 3. Ustaw ilość produktu
  // =========================
  await expect(quantityInput).toBeVisible();
  await quantityInput.fill(PRODUCT.quantity);

  // =========================
  // 4. Dodaj produkt do koszyka
  // =========================
  await expect(addToCartButton).toBeVisible();
  await addToCartButton.click();

  await expect(successMessage).toBeVisible();

  // =========================
  // 5. Przejdź do koszyka
  // =========================
  await page.goto(CART_URL);

  await expect(page).toHaveURL(CART_URL);

  // =========================
  // 6. Pobierz cenę
  // =========================
  const cartTotal = await getCartPrice();

  console.log(`Cena w koszyku: ${cartTotal} zł`);

  // =========================
  // 7. Zweryfikuj cenę
  // =========================
  expect(cartTotal).toBe(PRODUCT.expectedPrice);
});
